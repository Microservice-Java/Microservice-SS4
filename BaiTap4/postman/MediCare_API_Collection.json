						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8761",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8761"
						}
					}
				},
				{
					"name": "Get Eureka Registered Apps (JSON)",
					"request": {
